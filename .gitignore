# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/

# Data (large files - too big for GitHub even with LFS free tier)
*.tif
*.tiff
data/raw/*.nc
data/raw/*.hdf
data/raw/*.pdf
*.zip

# Large generated HTML maps (regenerable from scripts, 80+ MB each)
experiments/*/results/suitability_map.html
experiments/*/results/*.html
maps/*.html

# Models (large files)
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# LaTeX build artifacts
*.aux
*.log
*.out
*.blg

# Secrets
.env

# Claude Code local settings (contains personal paths)
.claude/

# Playwright browser automation artifacts (ephemeral)
.playwright-mcp/

# Screenshots from Playwright session debugging (repo root)
/compose-*.png
/page-*.png

# LaTeX build artifacts not already covered
*.bbl
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
