# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/

# Data (large files - too big for GitHub even with LFS free tier)
*.tif
*.tiff
data/raw/*.nc
data/raw/*.hdf
data/raw/*.pdf
*.zip

# Large generated HTML maps (regenerable from scripts, 80+ MB each)
experiments/*/results/suitability_map.html
experiments/*/results/*.html
maps/*.html

# Models (large files)
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# LaTeX build artifacts
*.aux
*.log
*.out
*.blg

# Secrets
.env

# Claude Code local settings (contains personal paths)
.claude/

# Playwright browser automation artifacts (ephemeral)
.playwright-mcp/

# Screenshots from Playwright session debugging (repo root)
/compose-*.png
/page-*.png

# LaTeX build artifacts not already covered
*.bbl
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# GLOBALISE VOC corpus (multi-GB, regenerable via tools/voc_archnlp downloader)
# NOTE: first batch (50 raw + 100 clean files, ~113 MB) was committed before this
# rule and stays tracked; everything new is excluded.
data/raw/globalise_voc/
data/processed/globalise_voc/clean_*.txt
data/processed/globalise_voc/paras_*.txt
data/normalized/

# E211 bulk extraction outputs (50-125 MB each; regenerable via voc_archnlp extract)
# Small files kept: ANNOTATION_GUIDE_v1.md, annotation_sample_v1.csv, voc_mentions_high_precision.csv
results/E211_voc_mentions/voc_archaeological_mentions.csv
results/E211_voc_mentions/voc_archaeological_mentions.json
results/E211_voc_mentions/voc_mentions_java_filtered.csv
results/E211_voc_mentions/voc_mentions_normalized.csv
results/E211_voc_mentions/voc_mentions_normalized.json

# --- Confidential peer-review material and internal review simulations ---
# The paper's Data Availability statement points reviewers and editors at this
# repository. These files must NOT be browsable there:
#  - 02_LAPORAN_REVIEWER.md holds the JCAA #280 editor decision and both
#    reviewer reports verbatim; peer review is confidential and it is not ours
#    to publish, least of all while the paper is still in revision.
#  - 05_/07_*GO_FRENDI.md are AI-written simulated reviews carrying a real
#    person's name; publishing them would misrepresent him.
# They stay on disk as the working record; they simply stop being published.
papers/P2_settlement_model/review_package_20260727/02_LAPORAN_REVIEWER.md
papers/P2_settlement_model/review_package_20260727/05_REVIEW_COAUTHOR_GO_FRENDI.md
papers/P2_settlement_model/review_package_20260727/07_REVIEW_KERAS_Q1_GO_FRENDI.md
